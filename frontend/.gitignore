# =========================
# 依赖
# =========================
node_modules/
.pnp/
.pnp.js

# 包管理器调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =========================
# 构建输出
# =========================
dist/
dist-ssr/
build/
out/
coverage/
lib-cov/

# =========================
# Vite
# =========================
# Vite 缓存。默认在 node_modules/.vite，通常已被 node_modules 覆盖；
# 如果你自定义了 cacheDir，则需要保留这一行。
.vite/

# Vite 配置文件变更检测产生的临时文件
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
vite.config.*.timestamp-*

# =========================
# 环境变量与本地配置
# =========================
.env
.env.*
!.env.example
!.env.*.example

*.local
vite.config.*.local

# =========================
# 日志
# =========================
logs/
*.log
*.pid
*.seed
*.pid.lock

# =========================
# 缓存与构建信息
# =========================
.cache/
.parcel-cache/
.rollup.cache/
.turbo/
.eslintcache
.stylelintcache
.prettiercache
*.tsbuildinfo

# =========================
# 测试与覆盖率
# =========================
coverage/
coverage-final.json
.nyc_output/

# Vitest
node_modules/.vitest/
vitest-report.html
vitest-report.json

# Cypress
cypress/videos/
cypress/screenshots/

# Playwright
playwright-report/
test-results/

# =========================
# 编辑器 / IDE
# =========================
# VS Code：默认忽略，但保留团队共享配置
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains
.idea/

# 其他编辑器
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# =========================
# 操作系统文件
# =========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
